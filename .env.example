# ============================================================================
#  Missão Evangélica do Brasil — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env.
# ============================================================================

NODE_ENV=development

# ---- Aplicação ----
APP_URL=http://localhost:3000
APP_NAME="Missão Evangélica do Brasil"

# ---- Banco de dados (PostgreSQL) ----
DATABASE_URL="postgresql://meb:meb@localhost:5432/meb?schema=public"

# ---- Segurança ----
# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-segredo-de-pelo-menos-32-caracteres"
HASH_PEPPER="troque-por-outro-segredo-diferente-do-auth-secret"
CRON_SECRET="segredo-usado-no-header-x-cron-secret"
AUTH_ACCESS_TTL_MIN=20
AUTH_REFRESH_TTL_DAYS=30

# ---- Pagamentos ----
# SANDBOX reproduz toda a máquina de estados sem credenciais reais.
PAYMENT_PROVIDER=SANDBOX
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- Sede: geocerca usada por presença e validação de fotos ----
HQ_LATITUDE=-22.8735
HQ_LONGITUDE=-43.4426
HQ_GEOFENCE_RADIUS_M=400

# ---- Mídia ----
MEDIA_STORAGE=local
MEDIA_MAX_MB=25

# ---- E-mail (opcional) ----
# SMTP_URL="smtp://usuario:senha@smtp.provedor.com:587"
MAIL_FROM="contato@missaoevangelicadobrasil.org.br"
